# ===== Copy this file to ".env" and fill in your real values =====

# Server
PORT=3000

# --- Affiliate accounts (from Amazon Associates / Flipkart / Meesho dashboards) ---
AMAZON_ASSOCIATE_TAG=your-amazon-tag-21
FLIPKART_AFFILIATE_ID=your-flipkart-id
MEESHO_AFFILIATE_ID=your-meesho-id

# --- Meta (Instagram + Facebook auto-posting) ---
META_PAGE_ID=your-facebook-page-id
META_ACCESS_TOKEN=your-long-lived-access-token

# --- Free AI for content generation + the in-app guide chat ---
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# --- Database (Railway/Render will auto-generate this when you add PostgreSQL) ---
DATABASE_URL=postgres://user:password@host:5432/dbname
